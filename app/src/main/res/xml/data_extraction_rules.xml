<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. Incident and cooling history is personal usage data and is kept out of
     cloud backups; it still moves with a direct device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="heatguard_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
        <!-- The API key is encrypted with a device-bound Keystore key, so it cannot move to another device. -->
        <exclude domain="sharedpref" path="heatguard_secure.xml" />
    </device-transfer>
</data-extraction-rules>
