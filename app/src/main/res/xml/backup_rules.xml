<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and earlier. HeatGuard is local-first: the incident database stays on this device
     and is not included in cloud backups. Settings (DataStore) may be restored. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="exports/" />
    <exclude domain="sharedpref" path="heatguard_secure.xml" />
</full-backup-content>
