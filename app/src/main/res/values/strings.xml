    <!-- Advice -->
    <string name="advice_unplug_title">Unplug the charger for now</string>
    <string name="advice_unplug_body">Charging adds heat. Disconnect it until the phone cools. HeatGuard cannot control charging, so this is up to you.</string>
    <string name="advice_wired_title">Prefer a cable to wireless charging</string>
    <string name="advice_wired_body">Wireless charging typically produces more heat than charging with a cable.</string>
    <string name="advice_stop_title">Pause demanding tasks</string>
    <string name="advice_stop_body">Games, video calls, navigation, recording and similar work keep the processor busy. Pausing them is usually the fastest way to cool down. HeatGuard cannot tell which app is responsible.</string>
    <string name="advice_case_title">Take the case off</string>
    <string name="advice_case_body">A case can trap heat. Removing it helps the phone shed heat.</string>
    <string name="advice_shade_title">Get out of the heat</string>
    <string name="advice_shade_body">Move the phone out of direct sunlight and away from a car dashboard or other warm surfaces.</string>
    <string name="advice_brightness_title">Lower the screen brightness</string>
    <string name="advice_brightness_body">A bright display is a significant source of heat. Reduce the brightness or turn the screen off.</string>
    <string name="advice_freezer_title">Do not use a fridge or freezer</string>
    <string name="advice_freezer_body">Cooling a phone quickly can cause condensation inside it and damage it. Let it cool gradually in a shaded, ventilated spot.</string>
    <string name="advice_airplane_title">Weak signal? Try airplane mode briefly</string>
    <string name="advice_airplane_body">Searching for a signal makes the radio work harder. If you can do without connectivity for a few minutes, airplane mode can help.</string>
    <string name="advice_system_title">Android is limiting performance</string>
    <string name="advice_system_body">The system reports thermal throttling. Reduce the load and let the phone cool.</string>
    <string name="advice_prevent_title">Act now to avoid overheating</string>
    <string name="advice_prevent_body">The temperature is climbing toward your threshold. Reducing load, or unplugging a charger, now can prevent an alert.</string>
    <string name="advice_charging_warms_title">Charging is adding heat</string>
    <string name="advice_charging_warms_body">The phone warms while it charges, especially during heavy use. Avoid demanding tasks while charging, or unplug if you can.</string>
    <string name="advice_resting_title">Keep the phone idle</string>
    <string name="advice_resting_body">Leave the screen off and avoid heavy use while the cooling session runs.</string>
    <string name="advice_work_title">Work profile</string>
    <string name="advice_work_body">Close video calls or screen sharing you do not need, and keep the phone out of direct sun while you work.</string>
    <string name="advice_nav_title">Navigation profile</string>
    <string name="advice_nav_body">Mount the phone out of direct sun and keep its vents clear. If it is warm, avoid fast charging while navigating.</string>
    <string name="advice_gaming_title">Gaming profile</string>
    <string name="advice_gaming_body">Take short breaks, lower the graphics settings, and avoid playing while the phone is charging.</string>
    <string name="advice_charging_profile_title">Charging profile</string>
    <string name="advice_charging_profile_body">Charge in a cool place without a case, and avoid demanding tasks while it charges.</string>
    <string name="advice_good_title">Temperature is normal</string>
    <string name="advice_good_body">No action needed. Keeping the phone out of direct sun and off soft surfaces helps it stay cool.</string>
    <string name="advice_sensor_title">Temperature sensor unavailable</string>
    <string name="advice_sensor_body">This device is not reporting a valid battery temperature, so advice cannot be tailored to it.</string>
